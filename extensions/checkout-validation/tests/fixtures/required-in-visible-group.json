{
  "payload": {
    "export": "cart-validations-generate-run",
    "target": "cart.validations.generate.run",
    "input": {
      "buyerJourney": {
        "step": "CHECKOUT_COMPLETION"
      },
      "shop": {
        "localTime": {
          "date": "2026-11-06"
        }
      },
      "validation": {
        "config": null
      },
      "cart": {
        "lines": [
          {
            "id": "gid://shopify/CartLine/1",
            "selection": {
              "value": "{\"s\":\"set_vg\",\"v\":1,\"a\":{\"wrap\":true}}"
            },
            "sellingPlanAllocation": null,
            "merchandise": {
              "__typename": "ProductVariant",
              "id": "gid://shopify/ProductVariant/1",
              "product": {
                "id": "gid://shopify/Product/1",
                "title": "Custom Tote",
                "pricing": {
                  "jsonValue": {
                    "id": "set_vg",
                    "v": 1,
                    "defaultLocale": "en",
                    "fields": [
                      {
                        "id": "wrap",
                        "type": "toggle",
                        "label": "Gift wrap"
                      },
                      {
                        "id": "grp",
                        "type": "group",
                        "label": "Wrapping",
                        "condition": {
                          "action": "show",
                          "match": "all",
                          "rules": [
                            {
                              "source": "field",
                              "field": "wrap",
                              "op": "not_empty"
                            }
                          ]
                        }
                      },
                      {
                        "id": "msg",
                        "type": "text",
                        "label": "Message",
                        "required": true
                      }
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "output": {
      "operations": [
        {
          "validationAdd": {
            "errors": [
              {
                "message": "Custom Tote needs Message. Go back to the product page to add it.",
                "target": "$.cart"
              }
            ]
          }
        }
      ]
    }
  }
}
