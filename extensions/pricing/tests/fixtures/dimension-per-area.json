            "expandedCartItems": [
              {
                "merchandiseId": "gid://shopify/ProductVariant/1",
                "quantity": 1,
                "price": {
                  "adjustment": {
                    "fixedPricePerUnit": {
                      "amount": "50.00"
                    }
                  }
                },
                "attributes": [
                  {
                    "key": "Size",
                    "value": "120 × 80 cm"
                  },
                  {
                    "key": "_shine_options",
                    "value": "{\"s\":\"set_dim\",\"v\":1,\"a\":{\"d\":[120,80]}}"
                  }
                ]
              },
              {
                "merchandiseId": "gid://shopify/ProductVariant/999",
                "quantity": 1,
                "price": {
                  "adjustment": {
                    "fixedPricePerUnit": {
                      "amount": "96.00"
                    }
                  }
                },
                "attributes": [
                  {
                    "key": "Add-ons",
                    "value": "Size +96.00 (USD)"
                  }
                ]
