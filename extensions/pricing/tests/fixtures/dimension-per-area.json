{
  "payload": {
    "export": "cart-transform-run",
    "target": "cart.transform.run",
    "input": {
      "presentmentCurrencyRate": "1.0",
      "cartTransform": {
        "config": {
          "jsonValue": {
            "addonVariantId": "gid://shopify/ProductVariant/999",
            "pricingPaused": false
          }
        }
      },
      "cart": {
        "lines": [
          {
            "id": "gid://shopify/CartLine/1",
            "quantity": 1,
            "cost": {
              "amountPerQuantity": {
                "amount": "50.0",
                "currencyCode": "USD"
              }
            },
            "selection": {
              "value": "{\"s\":\"set_dim\",\"v\":1,\"a\":{\"d\":[120,80]}}"
            },
            "sellingPlanAllocation": null,
            "merchandise": {
              "__typename": "ProductVariant",
              "id": "gid://shopify/ProductVariant/1",
              "product": {
                "pricing": {
                  "jsonValue": {
                    "id": "set_dim",
                    "v": 1,
                    "defaultLocale": "en",
                    "fields": [
                      {
                        "id": "d",
                        "type": "dimension",
                        "label": "Size",
                        "required": true,
                        "price": {
                          "type": "per_area",
                          "amount": 0.01
                        },
                        "settings": {
                          "unit": "cm",
                          "minWidth": 20,
                          "maxWidth": 200,
                          "minHeight": 20,
                          "maxHeight": 200
                        }
                      }
                    ]
                  }
                }
              }
            }
          }
        ]
      }
    },
    "output": {
      "operations": [
        {
          "lineExpand": {
